# Copy to .env and fill in. Everything is optional for local development:
# with no keys the app runs in demo mode.

# --- Basics ---
APP_NAME=ListingSpark
# Public URL, used for Stripe redirects and emails. No trailing slash.
BASE_URL=http://localhost:3000
PORT=3000
# NODE_ENV=production        # set in production (enables Secure cookies + HSTS; requires HTTPS)
# TRUST_PROXY=true           # set when running behind Render/Railway/Fly/nginx so rate limits see real IPs
DATABASE_PATH=./data/app.db
SUPPORT_EMAIL=support@example.com
# Comma-separated emails that can open /admin (revenue, AI cost, grant credits).
ADMIN_EMAILS=you@example.com
# Listings every new account gets for free.
FREE_CREDITS=5

# --- AI (https://console.anthropic.com) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
# low | medium | high. Higher = more thinking per listing = higher cost.
CLAUDE_EFFORT=low

# --- Payments (https://dashboard.stripe.com/apikeys) ---
STRIPE_SECRET_KEY=
# From the webhook endpoint you create for https://YOUR_DOMAIN/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
CURRENCY=usd
# Local testing only: "buy" buttons add credits without Stripe. Refused when NODE_ENV=production.
DEV_FAKE_PAYMENTS=false

# --- Email for password resets (https://resend.com) ---
# Without these, reset links are printed to the server log.
RESEND_API_KEY=
EMAIL_FROM=ListingSpark <hello@yourdomain.com>
